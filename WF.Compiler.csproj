<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WF.Compiler</RootNamespace>
    <AssemblyName>WF.Compiler</AssemblyName>
    <Version>0.9.8</Version>

    <!-- lua5.1.dll is a 32-bit Windows DLL, so the compiler must stay x86 for now -->
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <!-- Self contained, so build machines and containers don't need an x86 .NET runtime installed -->
    <SelfContained>true</SelfContained>

    <!-- Keep the original Properties/AssemblyInfo.cs (it uses a 0.9.8.* wildcard version) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>false</Deterministic>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- System.Drawing only works on Windows on modern .NET; that's fine while we're x86 Windows only -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The website service has its own projects and Node files -->
    <Compile Remove="service/**" />
    <None Remove="service/**" />
    <EmbeddedResource Remove="service/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource names must match the GetManifestResourceStream calls -->
    <EmbeddedResource Include="Resources/Wherigo.luac" LogicalName="WF.Compiler.Resources.Wherigo.luac" />
    <EmbeddedResource Include="Eluant/BindingSupport.lua" LogicalName="WF.Compiler.Eluant.BindingSupport.lua" />
    <None Update="lua5.1.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
